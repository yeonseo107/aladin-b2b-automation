# === 가상환경 ===
venv/
.venv/
ENV/

# === 환경변수 / 비밀키 (알라딘 TTBKey 등) ===
.env
*.env
!.env.example

# === 내부 작업 문서 (프로젝트 완성 전까지 비공개) ===
# 명세서/작업로그/트러블슈팅은 docs/ 에서 관리하며,
# 최종 결과는 README.md 로 정리한다.
docs/

# === 데이터 (샘플 입력/출력) ===
data/input/*
data/output/*
data/cache/
!data/input/.gitkeep
!data/output/.gitkeep
!data/input/sample_*.csv

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# === OS / IDE ===
.DS_Store
.vscode/
.idea/
