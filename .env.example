# 알라딘 OpenAPI 인증키 (http://blog.aladin.co.kr/openapi 에서 발급)
# 실제 키는 .env 파일에 넣고 절대 커밋하지 않는다.
ALADIN_TTB_KEY=ttbYOURKEY1234567890

# Claude API 키 (AI 비정형 입력 파싱 기능에 필요 — https://console.anthropic.com 에서 발급)
# 이 기능을 쓰지 않으면 비워둬도 된다.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 국립중앙도서관 seoji 서지 API 키 (KDC·판사항 보강 및 교차검증에 사용 — https://www.nl.go.kr/seoji 에서 발급)
# 없으면 보강 없이 알라딘 매칭만으로 동작한다.
NLK_CERT_KEY=YOURKEY